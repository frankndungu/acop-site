# Copy to .env.local and fill in. Never commit real values.

# WordPress GraphQL endpoint used to fetch news/events
WORDPRESS_API_URL=

# Password participants enter to access the workshop room
WORKSHOP_PASSWORD=

# Zoom/Meet link shown to authenticated participants only (server-side, never NEXT_PUBLIC_)
WORKSHOP_LINK=

# Random secret (32+ chars) used to sign workshop session cookies, e.g. `openssl rand -hex 32`
WORKSHOP_SESSION_SECRET=

# Optional: CMS login URL for authors (defaults to https://cms.acop.co.ke/wp-admin/)
NEXT_PUBLIC_CMS_LOGIN_URL=
